# ==============================================================================
# DocSmart AI — Environment Configuration Example
# Tagline: Turn documents into decisions.
# ==============================================================================

# Application Settings
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Security Credentials
# Header: X-API-Key
API_KEY=changeme
WEBHOOK_SIGNING_SECRET=changeme
ENABLE_PUBLIC_DEMO=true

# Database Configuration
# Defaults to SQLite for instant local runs; use PostgreSQL for production/docker.
DATABASE_URL=sqlite:///./docsmart.db
# DATABASE_URL=postgresql://docuser:docpass@localhost:5432/document_platform

# AI / LLM Providers (Optional for demo mode; required for live LLM extraction)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=

# Extraction & OCR Thresholds
CONFIDENCE_THRESHOLD=0.75
MAX_UPLOAD_SIZE_MB=15
ALLOWED_FILE_TYPES=pdf,png,jpg,jpeg
TESSERACT_CMD=/usr/bin/tesseract

# Downstream Automation (n8n Webhook)
N8N_WEBHOOK_URL=
N8N_WEBHOOK_ENABLED=false

# File Storage
STORAGE_PATH=./storage/uploads
